# Bearer token every caller must send as `authorization: Bearer <token>`.
# Generate one with: openssl rand -hex 32
BOTESITO_API_TOKEN=

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Numeric chat id. Message the bot from your account, then read
# result[0].message.chat.id from:
#   curl "https://api.telegram.org/bot<token>/getUpdates"
TELEGRAM_CHAT_ID=
